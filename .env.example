# Stateful Interview Agent 环境变量示例
# 按需取消注释并填写；未配置时会使用代码中的默认值。
# 注意：BaseSettings 会自动读取本文件中的键名（全大写下划线风格）。

# =========================
# 应用基础配置
# =========================

# 应用名称，通常无需修改
APP_NAME=Stateful Interview Agent

# 运行环境：dev / test / prod（按团队约定使用）
APP_ENV=dev

# 服务监听地址
APP_HOST=127.0.0.1

# 服务监听端口
APP_PORT=8000

# 数据库连接串
# 默认使用本地 sqlite；如需切换 PostgreSQL/MySQL，请替换为对应连接串
DATABASE_URL=sqlite:///./data/app.db

# =========================
# 日志配置
# =========================

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 日志目录
LOG_DIR=./logs

# 是否记录 LLM 请求/响应载荷
# true: 便于排查问题；false: 更简洁，也更利于减少敏感信息落盘
LOG_LLM_PAYLOADS=true

# 是否启用日志制品落盘
LOG_ARTIFACTS_ENABLED=false

# 是否将 JSON 日志美化输出
LOG_PRETTY_JSON=false

# 日志中文本预览截断长度
LOG_TEXT_PREVIEW_CHARS=240

# =========================
# 问题生成/校验配置
# =========================

# 代码细节阶段问题最大长度
# 未配置时默认 480
MAX_QUESTION_LENGTH=480

# 访谈最少轮数
INTERVIEW_MIN_TURNS=42

# 访谈最多轮数
INTERVIEW_MAX_TURNS=43

# =========================
# LLM 提供方选择
# =========================

# 可选值：openai_compatible / anthropic / opencode
LLM_PROVIDER=openai_compatible

# =========================
# OpenAI 兼容接口配置
# 当 LLM_PROVIDER=openai_compatible 时生效
# =========================

# OpenAI 兼容接口密钥
OPENAI_API_KEY=your_api_key

# OpenAI 兼容接口地址
OPENAI_BASE_URL=https://api.scnet.cn/api/llm/v1

# 主对话模型名（请填写平台实际支持的模型名）
OPENAI_MODEL=平台实际模型名

# 向量模型名；仅在启用 embedding 去重时需要
OPENAI_EMBEDDING_MODEL=平台实际模型名

# =========================
# Anthropic 配置
# 当 LLM_PROVIDER=anthropic 时生效
# =========================

# Anthropic API Key
ANTHROPIC_API_KEY=

# 自定义 Anthropic Base URL；直连官方时可留空
ANTHROPIC_BASE_URL=

# Anthropic 模型名
ANTHROPIC_MODEL=claude-sonnet-4-5

# Anthropic 最大输出 token 数
ANTHROPIC_MAX_TOKENS=4096

# =========================
# OpenCode 配置
# 当 LLM_PROVIDER=opencode 时生效
# =========================

# OpenCode 服务地址
OPENCODE_BASE_URL=http://localhost:4096

# OpenCode 请求超时时间（秒）
OPENCODE_TIMEOUT_SECONDS=180

# OpenCode 使用的模型名
OPENCODE_MODEL=mindflow/claude-opus-4-6

# =========================
# 重复问题防护配置
# =========================

# 是否启用 embedding 相似度去重
# 启用后需要同时提供 OPENAI_EMBEDDING_MODEL
DUPLICATE_GUARD_USE_EMBEDDINGS=false

# embedding 相似度阈值，越高越严格
DUPLICATE_GUARD_EMBEDDING_THRESHOLD=0.9
